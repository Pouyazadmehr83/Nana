# Django Settings
SECRET_KEY=django-insecure-nana-dev-secret-key-change-in-production-123456789
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web,0.0.0.0

# Database Settings (PostgreSQL)
DB_NAME=nana_db
DB_USER=nana_user
DB_PASSWORD=nana_password
DB_HOST=db
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Redis & Celery Settings
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# CORS Settings (Comma-separated for multiple origins)
CORS_ALLOW_ALL=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Throttling / Rate Limiting
THROTTLE_ANON=120/minute
THROTTLE_USER=1000/minute
THROTTLE_AUTH=20/minute

# Logging
LOG_LEVEL=INFO
