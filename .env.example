# ==============================================================================
# Nana Backend Environment Configuration Template (.env.example)
# Copy this file to '.env' and update the values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Django Settings
# ------------------------------------------------------------------------------
# SECURITY WARNING: Generate a secure random string for production!
# e.g., python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=django-insecure-change-this-to-a-secure-random-key-in-production

# Set DEBUG=False in production! Set to True only for local development.
DEBUG=True

# Comma-separated list of host/domain names that this Django site can serve.
# In production, specify your exact domain names (e.g., api.nana.example.com,nana.example.com).
ALLOWED_HOSTS=localhost,127.0.0.1,web,0.0.0.0

# ------------------------------------------------------------------------------
# Database Settings (PostgreSQL)
# ------------------------------------------------------------------------------
# Can be supplied as individual parameters or via DATABASE_URL:
DB_NAME=nana_db
DB_USER=nana_user
DB_PASSWORD=nana_secure_dev_password
DB_HOST=db
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Optional: Complete Database URL (e.g. for Render, Supabase, Neon, Railway)
# DATABASE_URL=postgresql://nana_user:nana_secure_dev_password@db:5432/nana_db

# ------------------------------------------------------------------------------
# Redis & Celery Settings
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CACHE_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# Cache TTL (seconds)
CACHE_DEFAULT_TIMEOUT=300

# ------------------------------------------------------------------------------
# Security, CORS & CSRF Settings
# ------------------------------------------------------------------------------
# Set CORS_ALLOW_ALL=False in production and specify allowed origins below!
CORS_ALLOW_ALL=False
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# Comma-separated list of trusted origins for CSRF protection (Django 4.0+)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:3000,http://localhost:5173,http://127.0.0.1:8000

# Production SSL & Cookie Security (Defaults to True in production when DEBUG=False)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# ------------------------------------------------------------------------------
# Cloud Media Storage (Cloudinary - Optional)
# ------------------------------------------------------------------------------
# If provided, uploads are automatically stored and served via Cloudinary CDN.
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Set to True to allow Django to serve local /media/ files without Nginx/Cloudinary
SERVE_MEDIA_LOCAL=False

# ------------------------------------------------------------------------------
# DRF Throttling & Rate Limiting
# ------------------------------------------------------------------------------
THROTTLE_ANON=120/minute
THROTTLE_USER=1000/minute
THROTTLE_AUTH=20/minute

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO

